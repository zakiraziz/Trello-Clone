# Trello SaaS - Production Environment Configuration
# IMPORTANT: Never commit real secrets to version control!
# Copy this file to .env and update with your production values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# For production, use a managed database service:
# - Supabase: https://supabase.com
# - Neon: https://neon.tech  
# - Render PostgreSQL: https://render.com/docs/databases
# - Railway: https://railway.app
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/trello_saas

# Authentication - Generate secure secrets:
# openssl rand -base64 32
JWT_SECRET=YOUR_SECURE_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=YOUR_SECURE_REFRESH_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (your deployed domain)
CLIENT_URL=https://yourdomain.com

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGIN=https://yourdomain.com

# Email Configuration - Choose one provider:
# Option 1: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Option 2: Resend
RESEND_API_KEY=your_resend_api_key

# Option 3: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASSWORD=your-app-password

# Email From Address
EMAIL_FROM=notifications@yourdomain.com

# Admin Notifications
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=Admin

# Stripe Configuration (for paid plans)
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Security
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your_secure_session_secret_min_32_chars

# Redis (optional - for caching in production)
REDIS_URL=redis://localhost:6379

# Sentry Error Monitoring (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project
SENTRY_TRACES_SAMPLE_RATE=0.1

# Application Info
GIT_COMMIT=production

# Webhook Settings
WEBHOOK_URL=https://yourdomain.com/api/webhooks/stripe