# Trello SaaS - Production Environment Configuration
# IMPORTANT: Never commit real secrets to version control!
# Copy this file to .env and update with your production values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# For production, use a managed database service like:
# - Supabase: https://supabase.com
# - Neon: https://neon.tech  
# - Render PostgreSQL: https://render.com/docs/databases
# Example: DATABASE_URL=postgresql://user:pass@host:5432/trello_saas
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/trello_saas

# Authentication
# Generate a strong secret: openssl rand -base64 32
# NEVER use the default dev key in production!
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# JWT Configuration
JWT_EXPIRES_IN=7d

# Frontend URL (your deployed domain)
CLIENT_URL=https://yourdomain.com

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Stripe Configuration (for paid plans)
# Get your keys at: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5