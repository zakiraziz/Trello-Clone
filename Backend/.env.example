# Trello SaaS Backend Environment
# Copy this to .env and update for production

# Server Configuration
PORT=5000
NODE_ENV=production

# Database - Use PostgreSQL in production
DATABASE_URL=postgresql://postgres:password@localhost:5432/trello_saas

# Authentication - CHANGE THIS IN PRODUCTION!
# Generate: openssl rand -base64 32
JWT_SECRET=dev-secret-key-for-testing-only-CHANGE-IN-PRODUCTION

# JWT Configuration
JWT_EXPIRES_IN=7d

# Client URL (frontend domain)
CLIENT_URL=http://localhost:3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000