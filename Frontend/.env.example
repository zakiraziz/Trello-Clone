# Trello SaaS Frontend Environment
# Copy this to .env and update for production

# API URL - Backend server address
# For production, this should be your backend domain or the same server
VITE_API_URL=http://localhost:5000/api

# For production with Docker, use:
# VITE_API_URL=http://localhost:5000/api
# Or if using a separate backend server:
# VITE_API_URL=https://api.yourdomain.com